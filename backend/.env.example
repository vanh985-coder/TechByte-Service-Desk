# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/servicedesk
DB_USERNAME=servicedesk_user
DB_PASSWORD=change_me_in_local_env
JPA_DDL_AUTO=update

# JWT Security Configuration (minimum 32 characters for HS256)
JWT_SECRET=replace_with_at_least_32_characters_random_secret_key
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

