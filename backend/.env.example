# Server Configuration
SERVER_PORT=8080

# PostgreSQL Database Configuration (Supports both DB_* and SPRING_DATASOURCE_*)
DB_URL=jdbc:postgresql://database:5432/servicedesk
DB_USERNAME=servicedesk_user
DB_PASSWORD=change_me_in_production
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false
JPA_DDL_AUTO=validate
SEED_DEMO_DATA=false

# JWT Security Configuration (minimum 32 characters for HS256)
JWT_SECRET=replace_with_at_least_32_characters_random_secret_key
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated or * for proxy/tunnel)
CORS_ALLOWED_ORIGINS=*
