# Copy to infra/compose/.env. Never commit that real file.
POSTGRES_DB=servicedesk
POSTGRES_USER=servicedesk_user
POSTGRES_PASSWORD=replace_with_a_random_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Production: hostname without scheme; URL includes https://.
APP_DOMAIN=desk.example.com
APP_URL=https://desk.example.com
APP_ENV_FILE=.env
TLS_DIR=/opt/techbyte/shared/tls

# CI may set FRONTEND_IMAGE and BACKEND_IMAGE to immutable GHCR digest references.
# Without them, Compose builds techbyte-frontend:local and techbyte-backend:local.
